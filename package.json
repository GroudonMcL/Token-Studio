{
  "name": "token-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Token Maker and Frame Studio in one web app: make tokens for tabletop RPGs and design their frames.",
  "author": "GroudonMcL",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "pages:dev": "npm run build && npx --yes wrangler@4 pages dev dist --port 8788 --compatibility-date=2026-09-01",
    "tm:frame-sheet": "tsx scripts/token-maker/frame-sheet.ts",
    "tm:effect-sheet": "tsx scripts/token-maker/effect-sheet.ts",
    "tm:help-images": "tsx scripts/token-maker/help-images.ts",
    "tm:make-fixture": "tsx scripts/token-maker/make-fixture.ts",
    "tm:make-backgrounds": "tsx scripts/token-maker/make-backgrounds.ts",
    "tm:make-frames": "tsx scripts/token-maker/make-frames.ts",
    "tm:decoration-sheet": "tsx scripts/token-maker/decoration-sheet.ts",
    "tm:label-sheet": "tsx scripts/token-maker/label-sheet.ts",
    "fs:frame-sheet": "tsx scripts/frame-studio/frame-sheet.ts",
    "fs:effects-sheet": "tsx scripts/frame-studio/effects-sheet.ts",
    "fs:screenshots": "tsx scripts/frame-studio/screenshots.ts",
    "fs:compare-conversions": "tsx scripts/frame-studio/compare-conversions.ts",
    "fs:showcase": "tsx scripts/frame-studio/showcase.ts",
    "fs:make-fixtures": "tsx scripts/frame-studio/make-fixtures.ts",
    "fs:look": "tsx scripts/frame-studio/look.ts"
  },
  "dependencies": {
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/eagle-lake": "^5.3.0",
    "@fontsource/germania-one": "^5.3.0",
    "@fontsource/grenze": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/macondo": "^5.3.0",
    "@fontsource/medievalsharp": "^5.3.0",
    "@fontsource/metamorphous": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@huggingface/transformers": "4.2.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.13",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
